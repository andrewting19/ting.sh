{
  "name": "ting.sh",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run dev:ensure-ptyd && concurrently -k -n server,vite -c cyan,magenta \"PTYD_AUTOSPAWN=false bun run dev:server\" \"bun run dev:client\"",
    "dev:ensure-ptyd": "AUTO_UPDATE=false PTYD_IDLE_EXIT_MS=0 bun run scripts/dev-ensure-ptyd.ts",
    "dev:server": "AUTO_UPDATE=false bun run --hot server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "bun run server.ts",
    "test": "bun test",
    "test:ui": "playwright test --ui",
    "release": "./scripts/release.sh",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major"
  },
  "dependencies": {
    "@andrewting19/ghostty-web": "0.5.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.9",
    "@playwright/test": "^1.58.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
